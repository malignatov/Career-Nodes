{
  "name": "career-counseling",
  "version": "1.0.0",
  "description": "A local-first app that guides a person through Mark Savickas's career construction counseling (*Career Counseling*, 2nd ed., APA 2019) as a journey across a map of artifacts, with an LLM playing the interviewer under narrow, fully visible instructions.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "interview": "node --env-file-if-exists=.env src/cli.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "ui": "node --env-file-if-exists=.env src/server.ts",
    "app": "electron app",
    "app:build": "electron-packager app 'Career Counseling' --platform=darwin --arch=$(node -p process.arch) --out=dist-app --overwrite --electron-version=$(node -p \"require('electron/package.json').version\")",
    "app:dist": "bash scripts/package-app.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "js-yaml": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "electron": "^43.0.0",
    "electron-packager": "^17.1.2",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
