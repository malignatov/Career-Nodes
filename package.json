{
  "name": "career-counseling",
  "version": "1.0.0",
  "description": "A local-first app that guides a person through Mark Savickas's career construction counseling (*Career Counseling*, 2nd ed., APA 2019) as a journey across a map of artifacts, with an LLM playing the interviewer under narrow, fully visible instructions.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "interview": "node --env-file-if-exists=.env src/cli.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "ui": "node --env-file-if-exists=.env src/server.ts",
    "app": "electron app",
    "app:build": "electron-packager app 'Career Nodes' --platform=darwin --arch=$(node -p process.arch) --out=dist-app --overwrite --electron-version=$(node -p \"require('electron/package.json').version\")",
    "app:dist": "bash scripts/package-app.sh",
    "app:dist:win": "bash scripts/package-app.sh win32 x64",
    "app:dist:linux": "bash scripts/package-app.sh linux x64",
    "probe": "node --env-file-if-exists=.env scripts/probe.ts",
    "vendor": "node --env-file-if-exists=.env src/vendor.ts",
    "mobile:build": "bash scripts/build-mobile.sh",
    "mobile:ios": "npx cap run ios",
    "golden": "node --env-file-if-exists=.env scripts/golden.ts",
    "judge": "node --env-file-if-exists=.env scripts/judge.ts"
  },
  "keywords": [],
  "author": "Mikhail Ignatov",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "js-yaml": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "electron": "^43.0.0",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
