# Copy to .env (gitignored) and fill in. Loaded automatically by npm scripts.

# Anthropic API key — used unless LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=

# Provider: anthropic (default) | ollama
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Model tier overrides
# LLM_SMALL_MODEL=claude-haiku-4-5
# LLM_LARGE_MODEL=claude-opus-4-8

# OpenAI API key — enables voice dictation (live transcription)
# OPENAI_API_KEY=

# ── Alternative LLM providers ─────────────────────────────
# Provider: anthropic (default) | openrouter | openai (any OpenAI-compatible URL) | ollama
# LLM_PROVIDER=openrouter
# LLM_API_KEY=            # key for openrouter / openai providers
# LLM_BASE_URL=           # provider=openai only; openrouter defaults to https://openrouter.ai/api/v1
# LLM_ZDR=1               # openrouter: route ONLY to zero-data-retention endpoints (default on; 0 disables)
# Per-tier overrides — e.g. fast tier direct at DeepInfra:
# LLM_SMALL_BASE_URL=https://api.deepinfra.com/v1/openai
# LLM_SMALL_API_KEY=
# LLM_SMALL_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Defaults with provider=openrouter: both tiers deepseek/deepseek-v4-pro
# After configuring, verify privacy flags + structured output: npm run probe
# LLM_IGNORE_PROVIDERS=DeepSeek,StreamLake,Baidu,Alibaba,SiliconFlow   # never route to these hosts, ZDR or not
# LLM_SORT=price          # openrouter endpoint ranking; default throughput (price sort ignores caching and can pick very slow hosts)
# LLM_STICKY_USER=        # openrouter cache-affinity id (opaque, not PII); default career-counseling — same id keeps routing on the provider that holds the prompt cache

# ── Key vendor (free-tier invites, see src/vendor.ts) ─────
# OPENROUTER_MANAGEMENT_KEY=   # dashboard → Settings → Provisioning keys
# VENDOR_CAP_USD=2             # credit cap per minted key
# VENDOR_PORT=4790
# LLM_ALLOW_PROVIDERS=DeepInfra,BaseTen,AtlasCloud,DigitalOcean,Morph  # fail-closed allowlist (preferred over ignore-list)
