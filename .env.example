# Copy to .env (gitignored) and fill in. Loaded automatically by npm scripts.

# Anthropic API key — used unless LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=

# Provider: anthropic (default) | ollama
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Model tier overrides
# LLM_SMALL_MODEL=claude-haiku-4-5
# LLM_LARGE_MODEL=claude-opus-4-8
